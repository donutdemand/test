# Server
PORT=3000

# Comma-separated Discord account tokens to preload on boot (optional).
# Example: DISCORD_TOKENS=tokenA,tokenB
DISCORD_TOKENS=

# Pause between accounts when joining a server (seconds + small random extra).
JOIN_DELAY_SECONDS=8

# Override for the CaptchaAI solver endpoint (2Captcha-style
# in.php/res.php, default https://ocr.captchaai.com).
# The key itself is set in the dashboard Settings.
CAPTCHAAI_API_URL=

# Minimum allowed interval between automated messages, in seconds.
# Protects your accounts from rate limits / bans. Keep >= 5.
MIN_INTERVAL_SECONDS=5

# Path to the JSON store file
STORE_PATH=./data/store.json
